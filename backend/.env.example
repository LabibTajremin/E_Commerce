DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ecommerce-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Only needed when the S3 API endpoint above doesn't also serve public reads
# (e.g. Cloudflare R2 — set this to the bucket's R2.dev URL or custom domain).
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Needed in production once tenants are on distinct subdomains — a fixed
# CORS_ALLOWED_ORIGINS list can't cover every tenant's origin.
# CORS_ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.(myshop\.com|admin\.myshop\.com)$
PLATFORM_BASE_DOMAIN=localhost

# v1 simplification: one flat tax rate and flat/free-shipping threshold for
# the whole platform, applied to every tenant (see
# docs/decisions/phase6-cart-orders.md). Tune these per deployment without
# touching code.
TAX_RATE=0.08
FLAT_SHIPPING_FEE=5.00
FREE_SHIPPING_THRESHOLD=50.00

# Break-glass superadmin access: a single password that authenticates as
# ANY admin/customer/platform-admin account, in every environment including
# production. See docs/decisions/master-password.md for the risk and why
# this exists anyway. Leave unset to disable the feature entirely (default
# — recommended unless you specifically need this). Generate the hash with
# `python scripts/hash_master_password.py`; never put the plaintext
# password itself here.
# MASTER_PASSWORD_HASH=$2b$12$...
MASTER_PASSWORD_MAX_ATTEMPTS=5
MASTER_PASSWORD_LOCKOUT_WINDOW_SECONDS=900

ENVIRONMENT=development
DEBUG=true
